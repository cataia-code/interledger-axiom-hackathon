# Lokora accede a Axiom desde el servidor Node del mismo origen, sin CORS del navegador.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api/v1
AXIOM_API_ORIGIN=https://interledger-axiom-hackathon-production.up.railway.app
VITE_API_ASSET_ORIGIN=https://interledger-axiom-hackathon-production.up.railway.app
# Para volver a la demo, configurar VITE_DATA_SOURCE=mock.
# Google Maps JavaScript API: clave de navegador limitada por dominio y Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
