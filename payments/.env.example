# Identidad de la app, la que firma las peticiones.
# No es la wallet de un comprador ni de un vendedor.
# La llave publica tiene que estar publicada en {CLIENT_WALLET_ADDRESS}/jwks.json.
CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/tu-app

# Key ID que muestra el dashboard, junto a la llave publica.
KEY_ID=

# Archivo private.key que descarga el dashboard al generar la llave.
PRIVATE_KEY_PATH=./private.key

# Puerto local al que la wallet redirige el navegador despues de aprobar.
PORT=3344
