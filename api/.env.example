PORT=3000
NODE_ENV=development
# Orígenes permitidos, separados por comas. En producción es obligatorio y no puede ser *
CORS_ORIGIN=*
DATABASE_URL=postgres://axiom:axiom@localhost:5432/axiom
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32+-chars
BETTER_AUTH_URL=http://localhost:3000
# Clave de Resend (https://resend.com/api-keys). Sin ella, en producción no se entregan correos
RESEND_API_KEY=
# Brevo (gratis, sin dominio propio: basta verificar el correo remitente en Brevo)
BREVO_API_KEY=
# Mailjet (gratis, 200/día, sin dominio propio: basta validar el correo remitente)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Opcional: fuerza el proveedor (brevo | mailjet | resend). Vacío = automático
MAIL_PROVIDER=
MAIL_FROM=Axiom <onboarding@resend.dev>
# Carpeta de imágenes subidas (por defecto ./uploads)
UPLOAD_DIR=
# Bucket compatible con S3 (Railway Bucket). Si S3_BUCKET está definido, las imágenes van al bucket y no a UPLOAD_DIR
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true solo si el proveedor exige URLs con el bucket en la ruta (MinIO, etc.)
S3_FORCE_PATH_STYLE=
COMMISSION_RATE=0.001
RESERVATION_TTL_MINUTES=15
# Secreto del webhook del proveedor de pago placeholder (cabecera X-Webhook-Secret)
PAYMENT_WEBHOOK_SECRET=
# Número de proxies delante de la API (p. ej. 1 detrás de un balanceador). Vacío = ninguno
TRUST_PROXY=

# Pagos: placeholder (simulado, para dev y tests) | openpayments (red de pruebas de Interledger)
PAYMENT_PROVIDER=placeholder
# Solo con openpayments. Identidad de la app, no de un usuario. La llave pública va en {OP_CLIENT_WALLET_ADDRESS}/jwks.json.
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
# Contenido de private.key: PEM, base64 del PEM o solo el cuerpo base64 (una línea) o, en local, la ruta del archivo. No se sube al repo.
OP_PRIVATE_KEY=
OP_PRIVATE_KEY_PATH=
# URL pública de esta API (la wallet vuelve a {PUBLIC_API_URL}/api/v1/payments/openpayments/return/:orderId)
PUBLIC_API_URL=http://localhost:3000
# Opcional. Al volver de la wallet el navegador ve una página de resultado ("Pago exitoso", "Pago declinado"…) que se cierra sola.
# Si defines esta URL, esa página ofrece "Volver a la app" hacia ella con ?payment=paid|failed|denied&order=ID, y los clientes de API (sin Accept text/html) reciben una redirección en lugar de JSON.
FRONTEND_URL=
