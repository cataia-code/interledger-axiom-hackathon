PORT=3000
NODE_ENV=development
# Orígenes permitidos, separados por comas. En producción es obligatorio y no puede ser *
CORS_ORIGIN=*
DATABASE_URL=postgres://axiom:axiom@localhost:5432/axiom
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32+-chars
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=Axiom <onboarding@resend.dev>
# Carpeta de imágenes subidas (por defecto ./uploads)
UPLOAD_DIR=
COMMISSION_RATE=0.001
RESERVATION_TTL_MINUTES=15
# Secreto del webhook del proveedor de pago placeholder (cabecera X-Webhook-Secret)
PAYMENT_WEBHOOK_SECRET=
# Número de proxies delante de la API (p. ej. 1 detrás de un balanceador). Vacío = ninguno
TRUST_PROXY=
